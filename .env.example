# База данных PostgreSQL (Asyncpg)
POSTGRES_USER=postgres_name
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=url_shortener_db
DATABASE_URL=postgresql+asyncpg://postgres_name:secret_password@db:5432/url_shortener_db

# Redis (для кэша и очередей)
REDIS_URL=redis://redis:6379/0

# Celery (брокер и бэкенд)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Безопасность и JWT
SECRET_KEY=change_me_to_very_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Базовый URL для генерации коротких ссылок в ответах API
BASE_URL=http://localhost:8001